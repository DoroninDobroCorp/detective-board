[Unit]
Description=Detective Board OLD PATH (Temporary for data export)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/srv/detective-board
# Use old config without base path
ExecStart=/usr/bin/npm run dev -- --host 0.0.0.0 --port 5174 --config vite.config.old.ts
Restart=no
Environment=NODE_ENV=development
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
